<div class="container mt-5">
    <h2 class="text-center mb-4 fw-bold">Ranking de Hinchadas</h2>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle bg-white">
            <thead class="table-dark">
                <tr>
                    <th scope="col" class="text-center">#</th>
                    <th scope="col">Equipo</th>
                    <th scope="col" class="text-center">Votos</th>
                    <th scope="col" class="text-center">Duelos Totales</th>
                    <th scope="col" class="text-center">Efectividad</th>
                </tr>
            </thead>
            <tbody>
                <?php $posicion = 1; ?>
                <?php foreach ($equipos as $equipo): ?>
                    <tr>
                        <th scope="row" class="text-center"><?php echo $posicion++; ?></th>
                        <td>
                            <img src="<?php echo BASE_URL . "img/escudos/" . $equipo->escudo; ?>"
                                 alt="Escudo"
                                 class="rounded-circle me-2"
                                 style="width: 40px; height: 40px; object-fit: cover;">
                            <span class="fw-bold"><?php echo $equipo->nombre; ?></span>
                        </td>
                        <td class="text-center"><?php echo $equipo->votos; ?></td>
                        <td class="text-center"><?php echo $equipo->duelos_totales; ?></td>
                        <td class="text-center">
                            <?php
                                // Cálculo de efectividad (evitando división por cero)
                                $efectividad = 0;
                                if ($equipo->duelos_totales > 0) {
                                    $efectividad = ($equipo->votos / $equipo->duelos_totales) * 100;
                                }
                            ?>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar bg-success"
                                     role="progressbar"
                                     style="width: <?php echo $efectividad; ?>%;"
                                     aria-valuenow="<?php echo $efectividad; ?>"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    <?php echo round($efectividad); ?>%
                                </div>
                            </div>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>

    <div class="text-center mt-4">
        <a href="<?php echo BASE_URL; ?>duelo" class="btn btn-primary btn-lg px-5">¡Seguir Votando!</a>
